<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" style="border-radius: 96px; overflow: hidden;">
  <!-- Dégradé de fond -->
  <defs>
    <linearGradient id="bgGradient" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color: #f5b301; stop-opacity: 1" />
      <stop offset="100%" style="stop-color: #e8590c; stop-opacity: 1" />
    </linearGradient>
  </defs>
  
  <!-- Fond -->
  <rect width="512" height="512" fill="url(#bgGradient)" />
  
  <!-- Traces de circuit d'arrière-plan (subtiles) -->
  <g stroke="#ffffff" stroke-width="2" stroke-opacity="0.2" fill="none">
    <path d="M 50,100 L 150,100 L 180,130 L 180,200" />
    <path d="M 400,100 L 300,100 L 270,130 L 270,200" />
    <path d="M 50,400 L 150,400 L 180,370 L 180,300" />
    <path d="M 400,400 L 300,400 L 270,370 L 270,300" />
    <circle cx="180" cy="200" r="4" fill="#ffffff" fill-opacity="0.2" stroke="none" />
    <circle cx="270" cy="200" r="4" fill="#ffffff" fill-opacity="0.2" stroke="none" />
    <circle cx="180" cy="300" r="4" fill="#ffffff" fill-opacity="0.2" stroke="none" />
    <circle cx="270" cy="300" r="4" fill="#ffffff" fill-opacity="0.2" stroke="none" />
  </g>
  
  <!-- Symbole central : Éclair moderne et stylisé -->
  <path d="M 256,50 L 350,220 L 280,220 L 330,462 L 162,242 L 232,242 Z" fill="#ffffff" />
  
  <!-- Traces de circuit et symboles intégrés -->
  <g stroke="#ffffff" stroke-width="4" fill="none">
    <!-- Connexion vers Livre (Suivi des notes) -->
    <path d="M 162,242 L 100,242 L 80,262" />
    <path d="M 80,262 L 80,320 L 120,320 M 80,280 L 110,280" />
    
    <!-- Connexion vers Toque (Terminale F3) -->
    <path d="M 330,100 L 360,100" />
    <path d="M 360,100 L 380,80 L 410,80 L 430,100 L 380,100" />
    <path d="M 380,100 L 380,110 A 30,30 0 0 1 330,110 Z" fill="#ffffff" stroke="none" />
    <rect x="425" y="100" width="10" height="40" fill="#ffffff" stroke="none" />
    <circle cx="430" cy="140" r="8" fill="#ffffff" stroke="none" />
  </g>
</svg>